# Rust build artifacts: 49 MB, and nothing outside research/solver-rs needs
# them. The engine is rebuilt with `cargo build --release` (see docs/SOLVER.md).
research/solver-rs/target/

# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Streamlit secrets -- never commit these
.streamlit/secrets.toml

# Personal Claude Code settings (local permissions)
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# Browser-automation screenshots and logs
.playwright-mcp/

# NOTE on what is deliberately NOT ignored:
#   research/data/dd_pilot.jsonl  (1.3 MB) is the solved double-dummy dataset. Every
#   figure in docs/BIDDING.md's "Hand evaluation and bidding research" is fitted from
#   it, and regenerating it costs hours of solver time, so it belongs in the
#   repo even though it is generated.
