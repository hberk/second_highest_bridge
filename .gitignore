# Rust build artifacts: 49 MB. The engine is rebuilt with `cargo build
# --release` (see docs/SOLVER.md); its WebAssembly build has its own
# research/solver-rs/wasm/.gitignore and is copied into frontend/ by npm run wasm.
research/solver-rs/target/

# The double dummy cache's append lock (research/dd_cache.py); the cache itself is kept.
research/data/*.lock

# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Personal Claude Code settings (local permissions)
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# Browser-automation screenshots and logs
.playwright-mcp/

# NOTE on what is deliberately NOT ignored:
#   research/data/dd_pilot.jsonl  (1.3 MB) is the solved double-dummy dataset. Every
#   figure in docs/BIDDING.md's "Hand evaluation and bidding research" is fitted from
#   it, and regenerating it costs hours of solver time, so it belongs in the
#   repo even though it is generated.
