{
  "name": "second-highest-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "vite build",
    "dev:beta": "npm run wasm && vite --mode beta",
    "build:beta": "npm run wasm && vite build --mode beta",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
