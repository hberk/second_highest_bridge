// The multiplayer table server on Cloudflare's Workers Free plan, at
// https://bridge.second-highest.workers.dev (MULTIPLAYER_PLAN.md, M7).
// Deployed from main by the `cloudflare` job in .github/workflows/pages.yml.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridge",
  "main": "src/worker.ts",
  // This tsconfig for every file, frontend/ included (as ../build.mjs does):
  // frontend/tsconfig.json extends a package only frontend/node_modules has.
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2026-11-01",
  // node:crypto for the table ids and token hashes (../src/tables.ts).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // The site: `npm run site` builds it, with the socket address in
    // its Content-Security-Policy, and copies _headers in.
    "directory": "../../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/tables", "/tables/*", "/healthz", "/visit", "/boards", "/dev/*"],
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableObject" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableObject", "Limiter"] }],
  // Visitor counts (src/visits.ts, visitors.mjs). Free on Workers Free; the
  // dataset is created by the first write.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "bridge_visits" }],
  // Shared finished boards (src/boards.ts, docs/SHARED_BOARDS.md). The first
  // deploy creates the database (Wrangler provisions a binding with no id),
  // which needs the deploy token to hold D1 Edit; src/boards.ts makes the
  // table on first use.
  "d1_databases": [{ "binding": "BOARDS", "database_name": "bridge_boards" }],
  "vars": { "ALLOWED_ORIGINS": "https://bridge.second-highest.workers.dev" },
  "observability": { "enabled": true }
}
